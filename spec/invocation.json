{
  "spec_version": 1,
  "description": "Reproducing a resolved configuration as a standalone command line (`format_invocation` / `formatInvocation`). `resolved` is the settings by key; `options` are `prog` (the program name, written first), `always_include` and `skip` (keys), and `compare_defaults` (a complete map of what counts as each key's default; it replaces the declared defaults). A setting is written as `--flag=value` -- or a bare `--flag` for a boolean that is on -- unless it equals its default; a boolean that is off, and an unset value, are never written. Values are POSIX shell-quoted. `expect` is the whole command line.",
  "cases": [
    {
      "name": "a run that matches the defaults writes nothing",
      "settings": [
        {
          "key": "host",
          "type": "str",
          "default": "localhost"
        },
        {
          "key": "port",
          "type": "int",
          "default": 8080
        },
        {
          "key": "debug",
          "type": "bool",
          "default": false
        },
        {
          "key": "tags",
          "type": "list",
          "default": null
        },
        {
          "key": "ratio",
          "type": "float",
          "default": 0.5
        },
        {
          "key": "filter_col",
          "type": "str",
          "default": null
        }
      ],
      "resolved": {
        "host": "localhost",
        "port": 8080,
        "debug": false,
        "tags": null,
        "ratio": 0.5,
        "filter_col": null
      },
      "expect": ""
    },
    {
      "name": "the program name alone",
      "settings": [
        {
          "key": "host",
          "type": "str",
          "default": "localhost"
