      "resolved": {
        "host": "localhost",
        "port": 8080,
        "debug": false,
        "tags": null,
        "ratio": 0.5,
        "filter_col": null
      },
      "options": {
        "prog": "myapp"
      },
      "expect": "myapp"
    },
