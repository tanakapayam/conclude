{
  "spec_version": 1,
  "description": "Merging the layers `defaults < config < env < developer < cli`, casting each value as it lands. Layer values are raw (env values are strings, config values are whatever TOML gave). `expect` lists every setting; `error: true` means resolution fails.",
  "cases": [
    {
      "name": "defaults alone",
      "settings": [
        {
          "key": "host",
          "type": "str",
          "default": "localhost"
        },
        {
          "key": "port",
          "type": "int",
          "default": 8080
        },
        {
          "key": "debug",
          "type": "bool",
          "default": false
        },
        {
          "key": "tags",
          "type": "list",
          "default": null
        },
        {
          "key": "ratio",
          "type": "float",
          "default": 0.5
        }
      ],
      "layers": {},
      "expect": {
        "host": "localhost",
        "port": 8080,
        "debug": false,
        "tags": null,
        "ratio": 0.5
      }
    },
    {
      "name": "a config file beats the default",
      "settings": [
        {
          "key": "host",
          "type": "str",
          "default": "localhost"
        },
        {
          "key": "port",
          "type": "int",
          "default": 8080
        },
        {
          "key": "debug",
          "type": "bool",
          "default": false
        },
        {
          "key": "tags",
          "type": "list",
          "default": null
        },
        {
          "key": "ratio",
          "type": "float",
          "default": 0.5
        }
      ],
      "layers": {
        "config": {
          "port": 9000
        }
      },
      "expect": {
        "host": "localhost",
        "port": 9000,
        "debug": false,
        "tags": null,
        "ratio": 0.5
      }
    },
