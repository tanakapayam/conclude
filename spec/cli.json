{
  "spec_version": 2,
  "description": "What the command line gives a setting. `settings` are declared as usual; `argv` is the arguments after the program name. `expect` is the CLI layer: an object with one entry for each setting a flag set, by key -- a boolean as `true` (its flag) or `false` (its negation), anything else as the raw text, which casting turns into a value later -- and no entry for a setting no flag mentioned. `error: true` means the settings cannot be given flags or the arguments cannot be parsed: two settings that claim the same flag (with `argv` empty), an unknown flag, a value on a boolean's flag or its negation, a negation of a setting that is not a boolean, a value flag with no value. A boolean's flag is `--flag` and its negation is the `cli_negated_flag` of `naming.json`; the last flag given for a setting wins.",
  "cases": [
    {
      "name": "no arguments leave every setting unset",
      "settings": [
        {
          "key": "host",
          "type": "str",
          "default": "localhost"
        },
        {
          "key": "port",
          "type": "int",
          "default": 8080
        },
        {
          "key": "debug",
          "type": "bool",
          "default": false
        },
        {
          "key": "verbose",
          "type": "bool",
          "default": null
        },
        {
          "key": "filter_col",
          "type": "str",
          "default": null
        }
      ],
      "argv": [],
      "expect": {}
    },
    {
      "name": "a bare flag is true for a boolean",
      "settings": [
        {
          "key": "host",
          "type": "str",
          "default": "localhost"
        },
        {
          "key": "port",
          "type": "int",
          "default": 8080
        },
        {
          "key": "debug",
          "type": "bool",
          "default": false
        },
        {
          "key": "verbose",
          "type": "bool",
          "default": null
        },
        {
          "key": "filter_col",
          "type": "str",
          "default": null
        }
      ],
      "argv": [
        "--debug"
      ],
      "expect": {
        "debug": true
      }
    },
    {
      "name": "the negation is false",
      "settings": [
        {
          "key": "host",
          "type": "str",
          "default": "localhost"
        },
        {
          "key": "port",
          "type": "int",
          "default": 8080
        },
        {
          "key": "debug",
          "type": "bool",
          "default": false
        },
        {
          "key": "verbose",
          "type": "bool",
          "default": null
        },
        {
          "key": "filter_col",
          "type": "str",
          "default": null
        }
      ],
      "argv": [
        "--no-debug"
      ],
      "expect": {
        "debug": false
      }
    },
    {
      "name": "a boolean with no default takes both forms",
      "settings": [
        {
          "key": "host",
          "type": "str",
          "default": "localhost"
        },
        {
          "key": "port",
          "type": "int",
          "default": 8080
        },
        {
          "key": "debug",
          "type": "bool",
          "default": false
        },
        {
          "key": "verbose",
          "type": "bool",
          "default": null
        },
        {
          "key": "filter_col",
          "type": "str",
          "default": null
        }
      ],
      "argv": [
        "--no-verbose"
      ],
      "expect": {
        "verbose": false
      }
    },
    {
      "name": "the last of a flag and its negation wins: the negation",
      "settings": [
        {
          "key": "host",
          "type": "str",
          "default": "localhost"
        },
        {
          "key": "port",
          "type": "int",
          "default": 8080
        },
        {
          "key": "debug",
          "type": "bool",
          "default": false
        },
        {
